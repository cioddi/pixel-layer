{
  "name": "pixel-layer",
  "version": "0.1.0",
  "description": "Pixel art custom layers for MapLibre GL",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');['dist','dist-demo','docs'].forEach(d=>{if(fs.existsSync(d))fs.rmSync(d,{recursive:true,force:true});});\"",
    "dev": "vite --host",
    "build": "npm run clean && npm run build:lib && npm run build:types && npm run build:demo",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "tsc --project tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts --outDir docs",
    "preview": "vite preview --config vite.demo.config.ts"
  },
  "devDependencies": {
    "maplibre-gl": "^5.9.0",
    "playwright": "^1.56.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "peerDependencies": {
    "maplibre-gl": "^5.9.0"
  },
  "dependencies": {
    "@mapbox/point-geometry": "^0.1.0",
    "@maplibre/maplibre-gl-style-spec": "^24.2.0",
    "earcut": "^3.0.2",
    "gl-matrix": "^3.4.4",
    "three": "^0.180.0"
  }
}
